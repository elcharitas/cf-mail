{
  "name": "@elcharitas/cf-mail",
  "version": "0.2.0",
  "description": "Send email through Cloudflare.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcharitas/cf-mail.git"
  },
  "homepage": "https://github.com/elcharitas/cf-mail#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "cf-mail": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "wrangler": "4.151.1"
  }
}
